<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:task="http://www.springframework.org/schema/task"
       xmlns:aop="http://www.springframework.org/schema/aop">
  <bean id="dao" class="com.acme.OrderDao"/>
  <bean id="svc" class="com.acme.OrderService" init-method="start" destroy-method="stop">
    <property name="orderDao" ref="dao"/>
  </bean>
  <bean id="svcP" class="com.acme.OrderService" p:orderDao-ref="dao"/>
  <bean id="staticMade" class="com.acme.Factory" factory-method="create"/>
  <bean id="maker" class="com.acme.Maker"/>
  <bean id="made" factory-bean="maker" factory-method="make"/>
  <bean id="job" class="com.acme.NightlyJob"/>
  <task:scheduled-tasks>
    <task:scheduled ref="job" method="run" fixed-delay="1000"/>
  </task:scheduled-tasks>
  <bean id="audit" class="com.acme.AuditAspect"/>
  <aop:config>
    <aop:aspect ref="audit">
      <aop:before method="log" pointcut="execution(* *(..))"/>
    </aop:aspect>
  </aop:config>
  <bean id="holder" class="com.acme.LookupHolder">
    <lookup-method name="dao" bean="dao"/>
    <replaced-method name="swapped" replacer="dao"/>
  </bean>
  <!-- <bean id="gone" class="com.acme.Ghost" init-method="neverRead"/> -->
</beans>
