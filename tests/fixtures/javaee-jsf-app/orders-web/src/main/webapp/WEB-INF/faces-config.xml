<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="2.3">
  <converter>
    <converter-id>acme.money</converter-id>
    <converter-class>com.acme.orders.web.MoneyConverter</converter-class>
  </converter>
  <navigation-rule>
    <from-view-id>/orders/list.xhtml</from-view-id>
    <navigation-case>
      <from-outcome>detail</from-outcome>
      <to-view-id>/orders/detail.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>
